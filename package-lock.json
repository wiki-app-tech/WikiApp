<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>🏋️ Plan Visual SportClub + MyFitCoach</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #0d1117;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Segoe UI', system-ui, sans-serif;
      padding: 20px;
    }
    .container {
      background: #161b22;
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      max-width: 1100px;
      width: 100%;
    }
    h1 {
      color: #f0f6fc;
      font-weight: 600;
      font-size: 1.8rem;
      text-align: center;
      margin-bottom: 10px;
      letter-spacing: 1px;
    }
    .sub {
      color: #8b949e;
      text-align: center;
      margin-bottom: 20px;
      font-size: 0.95rem;
    }
    canvas {
      display: block;
      width: 100%;
      height: auto;
      background: #0d1117;
      border-radius: 16px;
      border: 1px solid #30363d;
      box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
    }
    .footer {
      color: #8b949e;
      text-align: center;
      margin-top: 16px;
      font-size: 0.85rem;
    }
    .footer a {
      color: #58a6ff;
      text-decoration: none;
    }
  </style>
</head>
<body>
<div class="container">
  <h1>🏋️ PLAN DE ENTRENAMIENTO · SPORTCLUB</h1>
  <p class="sub">Basado en la metodología MyFitCoach · 3 días / semana · Progresión dinámica</p>
  <canvas id="routineCanvas" width="1000" height="700"></canvas>
  <div class="footer">
    ⚡ <strong>Leyenda:</strong> 
    <span style="color:#f97583;">●</span> Piernas &nbsp; 
    <span style="color:#58a6ff;">●</span> Empuje (pecho/hombro) &nbsp; 
    <span style="color:#3fb950;">●</span> Tirón (espalda/bíceps) &nbsp; 
    <span style="color:#d29922;">●</span> Core &nbsp; 
    <span style="color:#bc8cff;">●</span> Funcional
  </div>
</div>
<script>
  (function() {
    const canvas = document.getElementById('routineCanvas');
    const ctx = canvas.getContext('2d');
    const W = 1000, H = 700;
    canvas.width = W;
    canvas.height = H;

    // Configuración de la tabla
    const colX = [50, 180, 370, 520, 670, 820]; // x de columnas
    const rowY = [80, 180, 280, 380, 480, 580]; // y de filas
    const colWidth = [130, 190, 150, 150, 150]; // anchos de columna: Día, Ejercicio, S, R, Descanso

    // Datos de la rutina (3 días)
    const days = [
      {
        name: 'Día 1 · Empuje + Piernas',
        color: '#58a6ff',
        exercises: [
          { name: 'Sentadilla con Barra', series: 4, reps: '8-12', rest: '90″', muscle: 'piernas' },
          { name: 'Press de Banca', series: 4, reps: '8-12', rest: '90″', muscle: 'empuje' },
          { name: 'Press Hombros Manc.', series: 3, reps: '10-15', rest: '60″', muscle: 'empuje' },
          { name: 'Extensión de Piernas', series: 3, reps: '12-15', rest: '60″', muscle: 'piernas' },
          { name: 'Elevaciones Laterales', series: 3, reps: '12-15', rest: '45″', muscle: 'empuje' },
          { name: 'Plancha Abdominal', series: 3, reps: '30-60″', rest: '45″', muscle: 'core' }
        ]
      },
      {
        name: 'Día 2 · Tirón + Piernas',
        color: '#3fb950',
        exercises: [
          { name: 'Peso Muerto Rumano', series: 4, reps: '8-12', rest: '90″', muscle: 'piernas' },
          { name: 'Dominadas / Jalón', series: 4, reps: '8-12', rest: '90″', muscle: 'tirón' },
          { name: 'Remo con Barra', series: 3, reps: '10-15', rest: '60″', muscle: 'tirón' },
          { name: 'Curl Isquiotibiales', series: 3, reps: '12-15', rest: '60″', muscle: 'piernas' },
          { name: 'Curl Bíceps Barra Z', series: 3, reps: '10-15', rest: '45″', muscle: 'tirón' },
          { name: 'Elevación de Talones', series: 4, reps: '12-15', rest: '45″', muscle: 'piernas' }
        ]
      },
      {
        name: 'Día 3 · Cuerpo Completo + Funcional',
        color: '#bc8cff',
        exercises: [
          { name: 'Prensa de Piernas', series: 4, reps: '10-15', rest: '60″', muscle: 'piernas' },
          { name: 'Aperturas (Chest Fly)', series: 3, reps: '12-15', rest: '60″', muscle: 'empuje' },
          { name: 'Remo al Mentón', series: 3, reps: '10-15', rest: '60″', muscle: 'tirón' },
          { name: 'Press Francés (Tríceps)', series: 3, reps: '10-15', rest: '45″', muscle: 'empuje' },
          { name: 'Circuito Funcional *', series: '3 rondas', reps: '12-15 c/u', rest: '60″', muscle: 'funcional' },
          { name: 'Rueda Abdominal / Crunch', series: 3, reps: '15-20', rest: '45″', muscle: 'core' }
        ]
      }
    ];

    // Mapeo de colores por grupo muscular
    const muscleColors = {
      'piernas': '#f97583',
      'empuje': '#58a6ff',
      'tirón': '#3fb950',
      'core': '#d29922',
      'funcional': '#bc8cff'
    };

    // Dibujar fondo y bordes
    ctx.clearRect(0, 0, W, H);

    // Fondo sutil
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, '#0d1117');
    grad.addColorStop(1, '#161b22');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // Dibujar encabezados de columna
    ctx.font = 'bold 14px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    const headers = ['Día / Ejercicio', 'Ejercicio', 'Series', 'Reps', 'Descanso'];
    const headerX = [colX[0]+colWidth[0]/2, colX[1]+colWidth[1]/2, colX[2]+colWidth[2]/2, colX[3]+colWidth[3]/2, colX[4]+colWidth[4]/2];
    ctx.fillStyle = '#f0f6fc';
    for (let i = 0; i < headers.length; i++) {
      ctx.fillText(headers[i], headerX[i], 50);
    }

    // Dibujar líneas verticales de separación
    ctx.strokeStyle = '#30363d';
    ctx.lineWidth = 1;
    let xPos = 0;
    for (let i = 0; i <= headers.length; i++) {
      xPos = (i === 0) ? colX[0] : (i === 1 ? colX[1] : (i === 2 ? colX[2] : (i === 3 ? colX[3] : (i === 4 ? colX[4] : colX[4]+colWidth[4]))));
      ctx.beginPath();
      ctx.moveTo(xPos, 60);
      ctx.lineTo(xPos, H-20);
      ctx.stroke();
    }

    // Dibujar cada día
    let yOffset = 80;
    for (let d = 0; d < days.length; d++) {
      const day = days[d];
      // Título del día (fila de encabezado)
      ctx.fillStyle = '#f0f6fc';
      ctx.font = 'bold 15px "Segoe UI", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(day.name, colX[0] + 10, yOffset + 15);

      // Dibujar línea horizontal separadora de día
      ctx.strokeStyle = '#30363d';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(50, yOffset + 35);
      ctx.lineTo(W-50, yOffset + 35);
      ctx.stroke();

      // Ejercicios del día
      const exercises = day.exercises;
      for (let e = 0; e < exercises.length; e++) {
        const ex = exercises[e];
        const y = yOffset + 55 + e * 35; // espacio entre filas

        // Fondo de fila alternado
        ctx.fillStyle = (e % 2 === 0) ? 'rgba(255,255,255,0.03)' : 'rgba(255,255,255,0.07)';
        ctx.fillRect(colX[0], y-15, colWidth[0]+colWidth[1]+colWidth[2]+colWidth[3]+colWidth[4], 35);

        // Columna 0: Nombre del ejercicio (con indentación)
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.font = '13px "Segoe UI", system-ui, sans-serif';
        ctx.fillStyle = '#c9d1d9';
        ctx.fillText(ex.name, colX[0] + 20, y);

        // Círculo de color según grupo muscular
        const color = muscleColors[ex.muscle] || '#8b949e';
        ctx.beginPath();
        ctx.arc(colX[0] + 10, y, 6, 0, 2 * Math.PI);
        ctx.fillStyle = color;
        ctx.fill();

        // Columna 1: Series
        ctx.textAlign = 'center';
        ctx.fillStyle = '#f0f6fc';
        ctx.font = 'bold 13px "Segoe UI", system-ui, sans-serif';
        ctx.fillText(ex.series, colX[1] + colWidth[1]/2, y);

        // Columna 2: Repeticiones
        ctx.fillStyle = '#f0f6fc';
        ctx.font = '13px "Segoe UI", system-ui, sans-serif';
        ctx.fillText(ex.reps, colX[2] + colWidth[2]/2, y);

        // Columna 3: Descanso
        ctx.fillStyle = '#8b949e';
        ctx.fillText(ex.rest, colX[3] + colWidth[3]/2, y);

        // (columna 4 vacía, solo visual)
      }

      // Avanzar al siguiente día
      yOffset += 55 + exercises.length * 35 + 20;
    }

    // Pie de página dentro del canvas
    ctx.fillStyle = '#8b949e';
    ctx.font = '11px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText('* Circuito Funcional: Sentadillas con Salto · Fondos en Banco · Mountain Climbers · Zancadas', W/2, H-8);

    // Ajustar altura del canvas al contenido (opcional, pero ya fijamos 700)
    // Dibujar leyenda de colores en la parte superior derecha (ya está fuera del canvas en HTML)

  })();
</script>
</body>
</html>